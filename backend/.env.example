# Copy to .env and adjust. All variables are prefixed with DISKADVISOR_.

DISKADVISOR_DATABASE_URL=postgresql+psycopg2://diskadvisor:diskadvisor@localhost:5432/diskadvisor

DISKADVISOR_DYNATRACE_BASE_URL=https://your-environment.live.dynatrace.com
DISKADVISOR_DYNATRACE_API_TOKEN=changeme
DISKADVISOR_DYNATRACE_METRIC_USEDPCT_SELECTOR=builtin:host.disk.usedPct
DISKADVISOR_DYNATRACE_METRIC_AVAILABLE_SELECTOR=builtin:host.disk.availableBytes
# Set to false only for self-signed/internal-CA Dynatrace Managed/ActiveGate
# endpoints where this host doesn't trust the issuing CA (SSL_CERTIFICATE_VERIFY_FAILED).
# Prefer trusting the CA (update-ca-trust) over this in production.
DISKADVISOR_DYNATRACE_VERIFY_SSL=true

# Ansible Automation Platform (AAP) Controller -- job_templates/{id}/launch/
# is POSTed with `limit=<hostname>` to scope the audit to the single target
# host; Controller's own inventory/credentials/RBAC reach the host.
DISKADVISOR_ANSIBLE_CONTROLLER_BASE_URL=https://aap-controller.example.internal
DISKADVISOR_ANSIBLE_CONTROLLER_TOKEN=changeme
DISKADVISOR_ANSIBLE_CONTROLLER_JOB_TEMPLATE_ID=0
DISKADVISOR_ANSIBLE_CONTROLLER_VERIFY_SSL=true
DISKADVISOR_ANSIBLE_CONTROLLER_POLL_INTERVAL_SECONDS=2
DISKADVISOR_SSH_AUDIT_TIMEOUT_SECONDS=30
DISKADVISOR_SSH_AUDIT_CACHE_TTL_HOURS=24

DISKADVISOR_THRESHOLD_APPROVE=75
DISKADVISOR_THRESHOLD_APPROVE_REDUCED=55
DISKADVISOR_THRESHOLD_MANUAL_REVIEW=30
